{
  "name": "BeachReport",
  "type": "object",
  "properties": {
    "beach_name": {
      "type": "string",
      "description": "\u0416\u0430\u0493\u0430\u0436\u0430\u0439 \u0430\u0442\u0430\u0443\u044b"
    },
    "photo_url": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "pollution_level": {
      "type": "string",
      "enum": [
        "clean",
        "medium",
        "dirty"
      ],
      "default": "medium"
    },
    "pollution_score": {
      "type": "number",
      "description": "0-100"
    },
    "waste_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated_items": {
      "type": "number"
    },
    "ai_summary": {
      "type": "string"
    },
    "reporter_name": {
      "type": "string"
    }
  },
  "required": [
    "photo_url",
    "pollution_level"
  ]
}