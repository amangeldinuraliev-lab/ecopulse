{
  "name": "CommunityReview",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 5
    },
    "text": {
      "type": "string"
    }
  },
  "required": [
    "post_id",
    "text"
  ]
}